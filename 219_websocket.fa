/// Cliente WebSocket
/// Conceptos: std/websocket, handshake, frames de texto
/// Nivel: avanzado
importar "std/io"
importar "std/websocket"

funcion main() {
    escribir("=== CLIENTE WEBSOCKET ===\n")
    escribir("Un WebSocket empieza con un handshake HTTP y sigue con frames.")
    escribir("")

    variable url = "ws://localhost:8080/chat"
    escribir("  conectar(" + url + ") ...")
    variable cliente = websocket.conectar(url)
    coincidir (cliente) {
        caso Ok(ws) -> {
            escribir("  ✔ conectado")
            escribir("  Enviando: \"hola\"")
            websocket.enviar_texto(ws, "hola")
            variable respuesta = websocket.recibir(ws)
            coincidir (respuesta) {
                caso Ok(msg) -> escribir("  <- " + msg)
                caso Error(e) -> escribir("  ⚠️ " + e.mensaje)
            }
            websocket.cerrar(ws)
        }
        caso Error(e) -> {
            escribir("  ⚠️ no se pudo conectar: " + e.mensaje)
            escribir("  (normal si no hay servidor escuchando)")
        }
    }

    escribir("")
    escribir("Tipos de frame (clase FrameWebSocket):")
    escribir("  es_texto()   → frame de texto")
    escribir("  es_binario() → frame binario")
    escribir("  es_cierre()  → cierre de conexión")
    escribir("  es_ping() / es_pong() → control")
    escribir("")
    escribir("API de std/websocket:")
    escribir("  conectar(url)              → cliente")
    escribir("  enviar_texto(cliente, txt)")
    escribir("  recibir(cliente)           → texto")
    escribir("  cerrar(cliente)")
}

main()
