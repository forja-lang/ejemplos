/// Rasgo que extiende otro rasgo (herencia)
/// Conceptos: herencia de rasgos, extends, jerarquía de interfaces
/// Nivel: avanzado
importar "std/io"

// Un rasgo puede extender otro, heredando sus métodos
rasgo Animal {
    funcion hacer_sonido() -> Texto
    funcion dormir() -> Texto
}

// Mascota extiende Animal (hereda hacer_sonido y dormir)
rasgo Mascota {
    funcion jugar() -> Texto
    funcion obtener_nombre() -> Texto
}

clase Perro {
    nombre

    constructor() {
        self.nombre = "Firulais"
    }
}

implementa Mascota para Perro {
    // Métodos de Animal
    funcion hacer_sonido() -> Texto {
        retornar "" + self.nombre + ": ¡Guau!"
    }
    funcion dormir() -> Texto {
        retornar "" + self.nombre + ": Zzz..."
    }
    // Métodos de Mascota
    funcion jugar() -> Texto {
        retornar "" + self.nombre + " juega con la pelota"
    }
    funcion obtener_nombre() -> Texto {
        retornar self.nombre
    }
}

clase Gato {
    nombre

    constructor() {
        self.nombre = "Bigotes"
    }
}

implementa Mascota para Gato {
    funcion hacer_sonido() -> Texto {
        retornar "" + self.nombre + ": ¡Miau!"
    }
    funcion dormir() -> Texto {
        retornar "" + self.nombre + ": ronronea durmiendo"
    }
    funcion jugar() -> Texto {
        retornar "" + self.nombre + " juega con un ovillo"
    }
    funcion obtener_nombre() -> Texto {
        retornar self.nombre
    }
}

funcion main() {
    escribir("=== Herencia de Rasgos ===\n")
    variable p = nuevo Perro()
    variable g = nuevo Gato()
    escribir(p.hacer_sonido())
    escribir(p.jugar())
    escribir(p.dormir())
    escribir("")
    escribir(g.hacer_sonido())
    escribir(g.jugar())
    escribir(g.dormir())
}

main()

