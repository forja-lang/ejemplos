/// Métodos con implementación por defecto en rasgos
/// Conceptos: método default, herencia de implementación, override
/// Nivel: avanzado
importar "std/io"

// Los rasgos pueden tener métodos con implementación por defecto
// Las clases pueden usarlos directamente o sobreescribirlos
rasgo Saludador {
    // Método sin implementación (debe implementarlo la clase)
    funcion obtener_nombre() -> Texto
    // Método con implementación por defecto
    funcion saludar()
    funcion despedirse()
}

clase Persona {
    nombre

    funcion obtener_nombre() -> Texto {
        retornar self.nombre
    }
    funcion saludar() {
        escribir("Hola, soy " + self.obtener_nombre() + "!")
    }
    funcion despedirse() {
        escribir("" + self.obtener_nombre() + " dice: ¡Chau!")
    }
}

clase Robot {
    codigo

    funcion obtener_nombre() -> Texto {
        retornar "Robot-" + self.codigo + ""
    }
    funcion saludar() {
        escribir("" + self.obtener_nombre() + ": SISTEMA INICIADO. Hola, humano.")
    }
    funcion despedirse() {
        escribir("" + self.obtener_nombre() + " dice: ¡Chau!")
    }
}

funcion main() {
    escribir("=== Métodos por Defecto ===\n")
    variable p = nuevo Persona()
    p.nombre = "Ana"
    p.saludar()
    p.despedirse()
    escribir("")
    variable r = nuevo Robot()
    r.codigo = "X7-42"
    r.saludar()
    r.despedirse()
}

main()

