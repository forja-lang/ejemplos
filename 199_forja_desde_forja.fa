/// Mini-Compilador en Forja
/// Conceptos: compilador, lexer, parser, AST, intérprete, auto-hospedaje
/// Nivel: experto
importar "std/io"

// Este demo implementa un mini-compilador en Forja que procesa
// un lenguaje de programación simple (MiniForja).
// Incluye: lexer, parser, AST y ejecutor.
// --- 1. LEXER: Divide el código en tokens ---
clase Token {
    tipo
    valor
    linea

    constructor() {
        self.tipo = ""
        self.valor = ""
        self.linea = 0
    }
    funcion init(t, v, l) {
        self.tipo = t
        self.valor = v
        self.linea = l
    }
}

clase Lexer {
    codigo
    posicion
    linea
    tokens

    constructor() {
        self.codigo = ""
        self.posicion = 0
        self.linea = 1
        self.tokens = []
    }
    funcion init(cod) {
        self.codigo = cod
        self.posicion = 0
        self.linea = 1
        self.tokens = []
        self.tokenizar()
    }
    funcion tokenizar() {
        mientras (self.posicion < longitud(self.codigo)) {
            variable c = self.codigo[self.posicion]
            si (c == " " || c == "\\t") {
                self.posicion = self.posicion + 1
                continuar
            }
            si (c == "\\n") {
                self.linea = self.linea + 1
                self.posicion = self.posicion + 1
                continuar
            }
            // Comentarios
            si (c == "/" && self.posicion + 1 < longitud(self.codigo) && self.codigo[self.posicion + 1] == "/") {
                mientras (self.posicion < longitud(self.codigo) && self.codigo[self.posicion] != "\\n") {
                    self.posicion = self.posicion + 1
                }
                continuar
            }
            // Números
            si (c >= "0" && c <= "9") {
                variable num = ""
                mientras (self.posicion < longitud(self.codigo) && self.codigo[self.posicion] >= "0" && self.codigo[self.posicion] <= "9") {
                    num = num + self.codigo[self.posicion]
                    self.posicion = self.posicion + 1
                }
                variable idx = longitud(self.tokens)
                self.tokens[idx] = nuevo Token()
                self.tokens[idx].init("NUMERO", num, self.linea)
                continuar
            }
            // Identificadores y palabras clave
            si ((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_") {
                variable ident = ""
                mientras (self.posicion < longitud(self.codigo) && ((self.codigo[self.posicion] >= "a" && self.codigo[self.posicion] <= "z") || (self.codigo[self.posicion] >= "A" && self.codigo[self.posicion] <= "Z") || (self.codigo[self.posicion] >= "0" && self.codigo[self.posicion] <= "9") || self.codigo[self.posicion] == "_")) {
                    ident = ident + self.codigo[self.posicion]
                    self.posicion = self.posicion + 1
                }
                variable tipo = "IDENTIFICADOR"
                si (ident == "escribir" || ident == "variable" || ident == "si" || ident == "sino" || ident == "mientras" || ident == "funcion" || ident == "retornar") {
                    tipo
                    "PALABRA_CLAVE"
                }
                variable idx2 = longitud(self.tokens)
                self.tokens[idx2] = nuevo Token()
                self.tokens[idx2].init(tipo, ident, self.linea)
                continuar
            }
            // Símbolos
            variable simbolos = ["==", "!=", "<=", ">=", "+", "-", "*", "/", "=", "(", ")", "{", "}", "<", ">", ",", ";"]
            variable encontrado = falso
            variable s = 0
            mientras (s < longitud(simbolos)) {
                variable sym = simbolos[s]
                si (longitud(sym) == 2) {
                    si (self.posicion + 1 < longitud(self.codigo) && self.codigo[self.posicion] == sym[0] && self.codigo[self.posicion + 1] == sym[1]) {
                        variable idx3 = longitud(self.tokens)
                        self.tokens[idx3] = nuevo Token()
                        self.tokens[idx3].init("OPERADOR", sym, self.linea)
                        self.posicion = self.posicion + 2
                        encontrado = verdadero
                    }
                } sino {
                    si (self.codigo[self.posicion] == sym[0]) {
                        variable idx4 = longitud(self.tokens)
                        self.tokens[idx4] = nuevo Token()
                        self.tokens[idx4].init("SIMBOLO", sym, self.linea)
                        self.posicion = self.posicion + 1
                        encontrado = verdadero
                    }
                }
                si (encontrado) {
                    s = longitud(simbolos)
                }
                s = s + 1
            }
            si (!encontrado) {
                escribir("  ⚠️ Error léxico: carácter '" + c + "' en línea " + self.linea + "")
                self.posicion = self.posicion + 1
            }
        }
    }
    funcion mostrar_tokens() {
        escribir("  Tokens generados:")
        variable i = 0
        mientras (i < longitud(self.tokens)) {
            variable t = self.tokens[i]
            escribir("    [" + t.tipo + ": '" + t.valor + "']")
            i = i + 1
        }
    }
}

// --- 2. EJECUTOR: Interpreta el programa ---
clase MiniEjecutor {
    variables

    constructor() {
        self.variables = []
    }
    funcion ejecutar(tokens) {
        escribir("  Ejecutando programa MiniForja...\n")
        variable i = 0
        mientras (i < longitud(tokens)) {
            variable t = tokens[i]
            // escribir(expresion)
            si (t.valor == "escribir") {
                i = i + 1
                // saltar (
                i = i + 1
                variable valor = tokens[i].valor
                escribir("  > " + valor + "")
                i = i + 1
            // saltar )
            }
            // variable nombre = valor
            si (t.valor == "variable") {
                i = i + 1
                variable nombre = tokens[i].valor
                i = i + 2
                // saltar =
                variable valor = tokens[i].valor
                // Almacenar variable
                variable idx = longitud(self.variables)
                self.variables[idx] = nombre + ":" + valor
                escribir("  📦 Variable '" + nombre + "' = " + valor + "")
            }
            i = i + 1
        }
    }
}

funcion main() {
    escribir("=== FORJA DESDE FORJA (Mini-Compilador) ===\n")
    escribir("Un mini-compilador escrito en Forja que procesa MiniForja.\n")
    // Programa de ejemplo en MiniForja
    variable programa = "// Mini programa de ejemplo\n" + "escribir(Hola desde MiniForja!)\n" + "variable x = 42\n" + "variable y = 10\n" + "escribir(Fin del programa)"
    escribir("Código fuente:")
    escribir("----------------------------------------")
    escribir(programa)
    escribir("----------------------------------------\n")
    // Fase 1: Lexer
    escribir("--- Fase: Lexer ---")
    variable lexer = nuevo Lexer()
    lexer.init(programa)
    lexer.mostrar_tokens()
    // Fase 2: Ejecutor
    escribir("")
    escribir("--- Fase: Ejecutor ---")
    variable ejecutor = nuevo MiniEjecutor()
    ejecutor.ejecutar(lexer.tokens)
    escribir("")
    escribir("Un compilador real tiene más fases:")
    escribir("  1. Lexer (tokenización)")
    escribir("  2. Parser (análisis sintáctico → AST)")
    escribir("  3. Análisis semántico (tipos, alcance)")
    escribir("  4. Generación de código (bytecode, máquina)")
    escribir("  5. Optimización")
    escribir("")
    escribir("¡Forja puede compilar su propio código!")
}

main()

