/// Eco UDP
/// Conceptos: UDP, datagramas, std/sockets (udp_*)
/// Nivel: avanzado
importar "std/io"

importar "std/sockets"

funcion main() {
    escribir("=== ECO UDP ===\n")
    escribir("UDP no tiene conexión: cada datagrama lleva su destino.")
    escribir("")
    variable puerto = 9090
    escribir("  udp_escuchar(" + puerto + ") ...")
    variable servidor = sockets.udp_escuchar(puerto)
    coincidir (servidor) {
        caso Ok(socket) -> {
            escribir("  ✔ socket UDP abierto en el puerto " + puerto + "")
            escribir("  El eco haría:")
            escribir("    datos = udp_recibir(socket, 1024)")
            escribir("    udp_enviar(socket, datos, origen, puerto_origen)")
            sockets.cerrar(socket)
            escribir("  ✔ socket cerrado")
        }
        caso Error(e) -> {
            escribir("  ⚠️ no se pudo abrir el puerto: " + e.mensaje)
        }
    }
    escribir("")
    escribir("Diferencias con TCP:")
    escribir("  TCP: conectar → enviar/recibir → cerrar (flujo ordenado)")
    escribir("  UDP: udp_enviar / udp_recibir (sin conexión, sin orden)")
    escribir("")
    escribir("API UDP de std/sockets:")
    escribir("  udp_escuchar(puerto)")
    escribir("  udp_enviar(socket, datos, direccion, puerto)")
    escribir("  udp_recibir(socket, tamano)")
}

main()

