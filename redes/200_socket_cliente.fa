importar "std/sockets"

funcion probar_conexion_http() {
    imprimir("Conectando a httpbin.org:80...")
    variable socket = conectar("httpbin.org", 80)
    imprimir("¡Conectado!")
    variable solicitud = "GET /get HTTP/1.1\r\nHost: httpbin.org\r\nConnection: close\r\n\r\n"
    variable bytes = enviar(socket, solicitud)
    imprimir("Enviados " + a_texto(bytes) + " bytes")
    variable datos = recibir(socket, 4096)
    imprimir("Respuesta (" + a_texto(longitud(datos)) + " bytes):")
    imprimir(datos)
    cerrar(socket)
    imprimir("Socket cerrado")
}

funcion probar_info_socket() {
    imprimir("")
    imprimir("--- Información del socket ---")
    variable socket = conectar("httpbin.org", 80)
    variable local = direccion_local(socket)
    variable remota = direccion_remota(socket)
    imprimir("Local: " + local)
    imprimir("Remoto: " + remota)
    cerrar(socket)
}

probar_conexion_http()

probar_info_socket()

imprimir("")

imprimir("Pruebas completadas.")

