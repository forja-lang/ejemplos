/// Servidor web HTTP
/// Conceptos: std/servidor_web, rutas, middlewares, respuestas
/// Nivel: avanzado
importar "std/io"
importar "std/servidor_web"

funcion main() {
    escribir("=== SERVIDOR WEB ===\n")

    variable puerto = 8080
    variable servidor = nuevo ServidorWeb(puerto)

    // Rutas: cada una asocia un método y una ruta a un manejador.
    servidor_web.obtener(servidor, "/", func(peticion, respuesta) {
        servidor_web.html(respuesta, "<h1>Hola desde Forja</h1>")
    })
    servidor_web.obtener(servidor, "/estado", func(peticion, respuesta) {
        servidor_web.texto_plano(respuesta, "ok")
    })
    servidor_web.enviar(servidor, "/saludo", func(peticion, respuesta) {
        servidor_web.texto_plano(respuesta, "creado")
    })

    // Middleware global: se ejecuta antes de cada manejador.
    servidor_web.usar(servidor, func(peticion, respuesta, siguiente) {
        siguiente()
    })
    servidor_web.habilitar_cors(servidor)

    escribir("  Servidor configurado en el puerto " + puerto + "")
    escribir("  Rutas registradas:")
    escribir("    GET  /         → html")
    escribir("    GET  /estado   → texto")
    escribir("    POST /saludo   → texto")
    escribir("")
    escribir("  iniciar(servidor) queda fuera de la demo: bloquea")
    escribir("  esperando peticiones, y aquí no hay nadie escuchando.")
    escribir("")
    escribir("  En un programa real:")
    escribir("    servidor_web.iniciar(servidor)   // bucle de aceptación")
    escribir("    servidor_web.detener(servidor)   // apagado ordenado")
}

main()
