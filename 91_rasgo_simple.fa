/// Rasgo simple: definición e implementación básica
/// Conceptos: rasgo, implementa, métodos de interfaz
/// Nivel: intermedio
importar "std/io"

// Un rasgo define un conjunto de métodos que una clase debe implementar
rasgo Volador {
    funcion volar()
    funcion aterrizar() -> Texto
}

clase Pajaro {
    nombre

    constructor() {
        self.nombre = "Sin nombre"
    }
}

implementa Volador para Pajaro {
    funcion volar() {
        escribir("" + self.nombre + " está volando...")
    }
    funcion aterrizar() -> Texto {
        retornar "" + self.nombre + " aterrizó exitosamente"
    }
}

clase Avion {
    modelo

    constructor() {
        self.modelo = "Boeing 747"
    }
}

implementa Volador para Avion {
    funcion volar() {
        escribir("" + self.modelo + " despegando...")
    }
    funcion aterrizar() -> Texto {
        retornar "" + self.modelo + " aterrizó en pista 27"
    }
}

funcion main() {
    escribir("=== Rasgo Simple ===\n")
    variable p = nuevo Pajaro()
    p.nombre = "Loro"
    p.volar()
    escribir(p.aterrizar())
    escribir("")
    variable a = nuevo Avion()
    a.volar()
    escribir(a.aterrizar())
}

main()

