/// Rasgo con parámetros genéricos
/// Conceptos: rasgo<T>, genericidad en interfaces, tipo parametrizado
/// Nivel: avanzado
importar "std/io"

// Los rasgos pueden tener parámetros de tipo genérico
rasgo Comparador {
    funcion es_mayor(self: T, otro: T) -> Booleano
}

clase Numero {
    valor

    constructor(valor) {
        self.valor = valor
    }
}

implementa Comparador para Numero {
    funcion es_mayor(self: Entero, otro: Entero) -> Booleano {
        retornar self > otro
    }
}

// Caja genérica
