/// Sistema completo de Ownership y Préstamos en Forja
/// Conceptos: ownership, movimiento, préstamo inmutable (&), préstamo mutable
///            (&mut), parámetros `prestado`, exclusividad, liberación por ámbito
/// Nivel: avanzado
importar "std/io"

// ═══════════════════════════════════════════════════════════════════════════════
// 1. OWNERSHIP (PROPIEDAD) BÁSICO
// ═══════════════════════════════════════════════════════════════════════════════
funcion demo_ownership() {
    escribir("═══ 1. OWNERSHIP (PROPIEDAD) ═══\n")
    // Cada valor tiene un único dueño. Los arreglos se **mueven** al asignar.
    variable original = [1, 2, 3]
    escribir("  Array original: " + original + "")
    variable movido = original
    escribir("  Después de mover a 'movido': " + movido + "")
    // ❌ 'original' ya no es válido: fue movido.
    // escribir("" + original)   // Error: variable fue movida
    escribir("  ✔ El ownership se transfiere al asignar\n")

    // Prestar (&) NO mueve: el dueño sigue siendo el original.
    variable datos = [10, 20, 30]
    variable prestado = &datos
    escribir("  datos: " + datos + "")
    escribir("  prestado: " + prestado + "")
    escribir("  ✔ datos sigue siendo válido después del préstamo\n")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2. PRÉSTAMO INMUTABLE (&) — múltiples lectores a la vez
// ═══════════════════════════════════════════════════════════════════════════════
funcion demo_prestamo_inmutable() {
    escribir("═══ 2. PRÉSTAMO INMUTABLE (&) ═══\n")
    escribir("  Regla: muchos préstamos inmutables pueden coexistir\n")
    variable contador = 100
    escribir("  contador = " + contador + "")
    variable a = &contador
    variable b = &contador
    variable c = &contador
    escribir("  a = " + a + ", b = " + b + ", c = " + c + "")
    escribir("  ✔ Todos leen el mismo valor a la vez")
    // Los préstamos a, b y c se liberan al salir de la función.
}

// ═══════════════════════════════════════════════════════════════════════════════
// 3. PRÉSTAMO MUTABLE (&mut) — exclusivo
// ═══════════════════════════════════════════════════════════════════════════════
funcion demo_prestamo_mutable() {
    escribir("═══ 3. PRÉSTAMO MUTABLE (&mut) ═══\n")
    escribir("  Regla: solo UN préstamo mutable a la vez\n")
    variable puntaje = 50
    escribir("  puntaje original = " + puntaje + "")
    // ❌ No se puede tener otro préstamo simultáneo al mutable:
    // variable ref_mut = &mut puntaje
    // variable otro = &puntaje    // ❌ ya hay un préstamo mutable activo
    escribir("  ✔ (comentado) un segundo préstamo sería rechazado\n")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 4. PARÁMETROS PRESTADOS (keyword `prestado`) y mutables
// ═══════════════════════════════════════════════════════════════════════════════
funcion solo_leer(prestado texto: Texto) {
    // `prestado` es de sólo lectura: modificarlo sería un error.
    escribir("  lectura: " + texto)
}

funcion modificar(mut valor: Entero) {
    valor = valor + 1
    escribir("  modificado dentro: " + valor)
}

funcion demo_parametros() {
    escribir("═══ 4. PARÁMETROS PRESTADOS ═══\n")
    solo_leer("texto prestado")
    variable n = 10
    escribir("  antes: " + n + "")
    modificar(n)
    escribir("  después: " + n + "\n")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 5. LIBERACIÓN AUTOMÁTICA POR ÁMBITO
// ═══════════════════════════════════════════════════════════════════════════════
funcion demo_ambito() {
    escribir("═══ 5. LIBERACIÓN POR ÁMBITO ═══\n")
    variable valor = [1, 2]
    variable k = 0
    mientras (k < 1) {
        variable temporal = &valor
        escribir("  dentro del bloque: " + temporal + "")
        k = k + 1
    }
    // El préstamo `temporal` se liberó al salir del bloque.
    escribir("  fuera del bloque: " + valor + "")
    escribir("  ✔ valor vuelve a estar disponible\n")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 6. ERRORES QUE EL COMPROBADOR DE PRÉSTAMOS DETECTA (comentados)
// ═══════════════════════════════════════════════════════════════════════════════
funcion demo_errores() {
    escribir("═══ 6. ERRORES DETECTADOS ═══\n")
    escribir("  • Usar una variable después de moverla")
    escribir("  • Modificar mientras hay un préstamo inmutable activo")
    escribir("  • Tener dos préstamos mutables a la vez")
    escribir("  • Mover una variable que está prestada")
    escribir("  El compilador los reporta antes de ejecutar.\n")
}

funcion main() {
    escribir("=== OWNERSHIP Y PRÉSTAMOS EN FORJA ===\n")
    demo_ownership()
    demo_prestamo_inmutable()
    demo_prestamo_mutable()
    demo_parametros()
    demo_ambito()
    demo_errores()
    escribir("Fin del recorrido: el compilador garantiza memoria segura")
    escribir("sin recolector de basura y sin fugas.")
}

main()
