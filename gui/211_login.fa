importar "gui"

variable usuario = ""
variable contrasena = ""
variable resultado = ""

funcion validar_login() {
    si (usuario == "") {
        resultado = "El usuario es obligatorio"
    } sino si (contrasena == "") {
        resultado = "La contrasena es obligatoria"
    } sino {
        resultado = "Bienvenido, " + usuario + "!"
    }
}

funcion limpiar() {
    usuario = ""
    contrasena = ""
    resultado = ""
}

funcion main() {
    columna_centrada(contenedor(columna(espacio(20), titulo("Iniciar Sesion"), espacio(5), etiqueta_color("Accede a tu cuenta", "gris"), espacio(25), etiqueta("  Usuario"), entrada_texto("usuario", "Ingresa tu usuario"), espacio(12), etiqueta("  Contrasena"), entrada_texto("contrasena", "Ingresa tu contrasena"), espacio(20), fila(boton("  INICIAR SESION  ", &validar_login), espacio(8), boton("  LIMPIAR  ", &limpiar)), espacio(12), etiqueta_color("Olvidaste tu contrasena?", "azul"), espacio(20), separador(), espacio(8), etiqueta_color("Resultado:", "naranja"), escribir(resultado), espacio(25), etiqueta_color("Forja GUI Nativa - Xilem 0.4", "plateado"), espacio(15)), 380))
}

