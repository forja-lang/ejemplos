// Ejemplo de boton interactivo con Xilem
// Ejecutar: forja ejecutar ejemplos/203_boton_gui.fa
importar "gui"

funcion saludar() {
    escribir("¡Hola desde el botón!")
}

funcion main() {
    escribir("Bienvenido a la GUI interactiva")
    escribir("Hace click en el boton de abajo")
    boton("Saludar", &saludar)
    entrada_texto("Escribe algo aqui")
}

