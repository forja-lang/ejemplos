// ═══════════════════════════════════════════════════════════════════
//  LAYOUT RESPONSIVE — Window Size Classes + Layout avanzado
//  Demuestra: adaptable, columna_con_gap, fila_con_gap, flujo,
//             caja_relativa, flex_layout
// ═══════════════════════════════════════════════════════════════════
//
//  Ejecutar (nativo): forja ejecutar ejemplos/301_layout_responsive.fa
//
//  Requiere: Rust (la primera vez compila Xilem)
//
//  NOTA: La detección automática del tamaño de ventana se añadirá
//        en una versión futura. Por ahora, window_size se inicializa
//        como Compact (modo responsivo básico).
//
// ═══════════════════════════════════════════════════════════════════
importar "gui"

// Callback sin argumentos: la GUI llama y lee/escribe el global.
variable contador = 0
funcion incrementar() -> Texto {
    contador = contador + 1
    retornar a_texto(contador)
}

funcion main() {
    // ═══════════════════════════════════════════════
    //  HEADER
    // ═══════════════════════════════════════════════
    // ═══════════════════════════════════════════════
    //  CONTENIDO ADAPTABLE (Window Size Classes)
    // ═══════════════════════════════════════════════
    // adaptable recibe 3 layouts:
    //   1. Compact   (< 600px)  — columna vertical
    //   2. Medium    (600-840px) — mixto
    //   3. Expanded  (> 840px)  — fila horizontal
    // ─── Compact ───
    // ─── Medium ───
    // ─── Expanded ───
    // ═══════════════════════════════════════════════
    //  FLOW LAYOUT (wrap automático)
    // ═══════════════════════════════════════════════
    // ═══════════════════════════════════════════════
    //  COLUMNA CON GAP
    // ═══════════════════════════════════════════════
    // ═══════════════════════════════════════════════
    //  FILA CON GAP
    // ═══════════════════════════════════════════════
    desplazable(columna(texto_grande("Layout Responsive"), espacio(10), texto_mediano("Este layout cambia segun el tamano de ventana"), separador(), espacio(10), etiqueta(">>> Contenido adaptable (Window Size Classes):"), espacio(8), adaptable(columna(etiqueta("[Compact] Una columna vertical"), espacio(8), boton("Click", &incrementar), espacio(4), etiqueta_dinamica("contador")), columna(fila_con_gap([etiqueta("[Medium] Dos columnas"), boton("+", &incrementar)], 8, "centro"), espacio(4), etiqueta_dinamica("contador")), fila_con_gap([etiqueta("[Expanded] Layout horizontal completo"), boton("Incrementar", &incrementar), etiqueta_dinamica("contador")], 12, "centro")), espacio(16), separador(), espacio(10), texto_mediano("Flow Layout (wrap automatico):"), espacio(8), flujo([etiqueta("  Tag 1  "), etiqueta("  Tag 2  "), etiqueta("  Tag 3  "), etiqueta("  Tag 4  "), etiqueta("  Tag 5  "), etiqueta("  Tag 6  "), etiqueta("  Tag 7  "), etiqueta("  Tag 8  ")], 8), espacio(16), separador(), espacio(10), texto_mediano("Columna con gap personalizado:"), espacio(8), columna_con_gap([etiqueta("Elemento 1"), etiqueta("Elemento 2"), etiqueta("Elemento 3")], 4, "centro"), espacio(16), separador(), espacio(10), texto_mediano("Fila con gap y alineacion:"), espacio(8), fila_con_gap([boton("Izq", &incrementar), boton("Centro", &incrementar), boton("Der", &incrementar)], 16, "start"), espacio(16), espacio(20)))
}

