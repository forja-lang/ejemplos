// GUI Nativa — Contador interactivo
// Demuestra: variable de estado, label dinámico y botones con callback.
// Ejecutar: forja compilar ejemplos/gui/206_gui_contador.fa contador.exe
importar "gui"

funcion main() {
    variable cuenta = 0
    variable resultado = "0"
    columna(escribir("==========================="), escribir("        CONTADOR"), escribir("==========================="), escribir(""), escribir("Presiona los botones para"), escribir("incrementar o decrementar"), escribir(""), escribir(resultado), escribir(""), fila(boton("-1", &decrementar), boton("+1", &incrementar)), escribir(""), boton("Reset", &resetear), escribir(""), boton("Cerrar", &cerrar_app))
}

// Los callbacks escriben en `cuenta` (queda en el store de la GUI) y devuelven el
// texto que el runtime guarda en `resultado`, que es el label que se ve.
funcion incrementar() -> Texto {
    cuenta = cuenta + 1
    retornar a_texto(cuenta)
}

funcion decrementar() -> Texto {
    cuenta = cuenta - 1
    retornar a_texto(cuenta)
}

funcion resetear() -> Texto {
    cuenta = 0
    retornar a_texto(cuenta)
}

funcion cerrar_app() -> Texto {
    salir_app()
    retornar ""
}
