// Login App — GUI real con Forja + Xilem
// Formulario de login completo con validación.
//
// Los callbacks de botón no reciben argumentos: leen y escriben variables
// globales (así los comparte el estado de la GUI).
importar "gui"

variable usuario = ""
variable contrasena = ""
variable resultado = ""

funcion validar() {
    si (usuario == "") {
        resultado = "El usuario es obligatorio"
    } sino si (contrasena == "") {
        resultado = "La contraseña es obligatoria"
    } sino {
        resultado = "Bienvenido " + usuario
    }
}

funcion main() {
    columna(
        escribir("=================================="),
        escribir("      INICIAR SESION"),
        escribir("=================================="),
        escribir(""),
        escribir("Usuario:"),
        entrada_texto("usuario"),
        escribir(""),
        escribir("Contraseña:"),
        entrada_texto("contrasena"),
        escribir(""),
        boton("Ingresar", &validar),
        escribir(""),
        escribir(resultado),
        escribir(""),
        escribir("==================================")
    )
}

main()
