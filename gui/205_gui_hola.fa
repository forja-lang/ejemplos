// GUI Nativa — Hola Mundo
// Ejecutar: forja compilar ejemplos/gui/205_gui_hola.fa hola.exe   (o destino: nativo)
importar "gui"

funcion main() {
    columna(escribir("=================================="), escribir("        HOLA GUI NATIVA!"), escribir("=================================="), escribir(""), escribir("Bienvenido a Forja GUI"), escribir(""), boton("Cerrar", &cerrar_app))
}

// `salir_app()` es la única forma de terminar la app desde un callback:
// devolver un Texto no cierra la ventana.
funcion cerrar_app() -> Texto {
    salir_app()
    retornar ""
}
