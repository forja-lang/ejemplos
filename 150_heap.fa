/// Heap (montículo) para cola de prioridad
/// Conceptos: heap, montículo, max-heap, cola de prioridad, árbol binario en array
/// Nivel: avanzado
importar "std/io"

clase MaxHeap {
    elementos
    tamano

    constructor() {
        self.elementos = []
        self.tamano = 0
    }
    funcion padre(i) -> Entero {
        retornar (i - 1) / 2
    }
    funcion hijo_izquierdo(i) -> Entero {
        retornar 2 * i + 1
    }
    funcion hijo_derecho(i) -> Entero {
        retornar 2 * i + 2
    }
    funcion intercambiar(i, j) {
        variable temp = self.elementos[i]
        self.elementos[i] = self.elementos[j]
        self.elementos[j] = temp
    }
    funcion encolar(valor) {
        self.elementos[self.tamano] = valor
        self.tamano = self.tamano + 1
        variable i = self.tamano - 1
        mientras (i > 0 && self.elementos[self.padre(i)] < self.elementos[i]) {
            self.intercambiar(i, self.padre(i))
            i = self.padre(i)
        }
    }
    funcion hundir(i) {
        variable mayor = i
        variable izq = self.hijo_izquierdo(i)
        variable der = self.hijo_derecho(i)
        si (izq < self.tamano && self.elementos[izq] > self.elementos[mayor]) {
            mayor = izq
        }
        si (der < self.tamano && self.elementos[der] > self.elementos[mayor]) {
            mayor = der
        }
        si (mayor != i) {
            self.intercambiar(i, mayor)
            self.hundir(mayor)
        }
    }
    funcion desencolar() -> Entero {
        si (self.tamano == 0) {
            retornar nulo
        }
        variable maximo = self.elementos[0]
        self.elementos[0] = self.elementos[self.tamano - 1]
        self.tamano = self.tamano - 1
        self.hundir(0)
        retornar maximo
    }
    funcion ver_max() -> Entero {
        si (self.tamano == 0) {
            retornar nulo
        }
        retornar self.elementos[0]
    }
    funcion esta_vacia() -> Booleano {
        retornar self.tamano == 0
    }
    funcion mostrar() {
        escribir("  Máximo: " + self.ver_max() + "")
    }
}

funcion heap_sort(arr) {
    variable heap = nuevo MaxHeap()
    variable i = 0
    mientras (i < longitud(arr)) {
        heap.encolar(arr[i])
        i = i + 1
    }
    variable resultado = []
    variable j = 0
    mientras (!heap.esta_vacia()) {
        resultado[j]
        heap.desencolar()
        j = j + 1
    }
    retornar
    resultado
}

funcion main() {
    escribir("=== Heap (Montículo / Cola de Prioridad) ===\n")
    variable heap = nuevo MaxHeap()
    escribir("Encolando: 30, 10, 50, 20, 40, 60\n")
    heap.encolar(30)
    heap.encolar(10)
    heap.encolar(50)
    heap.encolar(20)
    heap.encolar(40)
    heap.encolar(60)
    heap.mostrar()
    escribir("")
    escribir("Desencolando (siempre el máximo):")
    mientras (!heap.esta_vacia()) {
        escribir("  " + heap.desencolar() + "")
    }
    escribir("")
    escribir("Heap Sort descendente:")
    variable numeros = [15, 3, 8, 22, 1, 19, 7, 12]
    escribir("  Original: " + numeros + "")
    variable ordenados = heap_sort(numeros)
    escribir("  Ordenado: " + ordenados + "")
    escribir("")
    escribir("El heap garantiza que el máximo sea siempre accesible en O(1).")
}

main()

