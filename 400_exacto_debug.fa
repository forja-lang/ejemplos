// Debug tests
variable x: Exacto = 10

variable y: Exacto = 3

escribir("x:")

escribir(x)

escribir("y:")

escribir(y)

escribir("x / y:")

escribir(x / y)

// Test abs
importar "std/matematica"

variable num: Exacto = -425e-1

escribir("num:")

escribir(num)

// Simple comparison
escribir("num < 0:")

escribir(num < 0)

// abs
variable absoluto: Exacto = absoluto(num)

escribir("absoluto(num):")

escribir(absoluto)

