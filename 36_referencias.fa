// 🎓 Lección 36: Referencias (&)
// Forja permite prestar valores con &
//
// Un préstamo **inmutable** (&) sirve para leer sin copiar. Mientras el
// préstamo está activo, la variable original no se puede modificar.
variable original = 42

funcion mostrar_por_referencia(prestado valor: Entero) {
    escribir("  por referencia: " + valor)
}

escribir("Original: " + original)
mostrar_por_referencia(&original)
mostrar_por_referencia(&original)

// Un préstamo guardado en una variable vive hasta el final del ámbito.
funcion demo_prestamo() {
    variable dato = 7
    variable referencia = &dato
    escribir("  referencia = " + referencia)
    // dato = 8   // ❌ el comprobador de préstamos lo rechaza:
    //            //    "No se puede modificar 'dato' porque tiene 1 préstamo"
}

escribir("")
escribir("Préstamo guardado en una variable:")
demo_prestamo()

// Para modificar hace falta un préstamo mutable (&mut), que es exclusivo:
// no puede convivir con otro préstamo.
funcion sumar_uno(mut valor: Entero) {
    valor = valor + 1
    escribir("  dentro: " + valor)
}

variable contador = 10
escribir("")
escribir("Préstamo mutable:")
sumar_uno(contador)

escribir("")
escribir("Resumen:")
escribir("  &x      → préstamo inmutable (sólo leer)")
escribir("  &mut x  → préstamo mutable (modificar), exclusivo")
escribir("  un préstamo activo impide modificar la variable original")
