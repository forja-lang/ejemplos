/// Cliente HTTP
/// Conceptos: std/cliente_http, GET/POST, Resultado, cabeceras
/// Nivel: avanzado
importar "std/io"

importar "std/cliente_http"

funcion main() {
    escribir("=== CLIENTE HTTP ===\n")
    escribir("Se hace un GET a un host de ejemplo.")
    escribir("Sin red el error se maneja igual: el Resultado lo exige.\n")
    variable url = "http://example.com/"
    escribir("GET " + url)
    variable respuesta = obtener(url)
    coincidir (respuesta) {
        caso Ok(r) -> {
            escribir("  código:  " + r.codigo)
            escribir("  estado:  " + r.status)
            escribir("  cuerpo:  " + longitud(r.cuerpo) + " caracteres")
            escribir("  exito:   " + r.exito)
        }
        caso Error(e) -> {
            escribir("  ⚠️ no se pudo conectar: " + e.mensaje)
            escribir("  (esperado si no hay red o el host no resuelve)")
        }
    }
    escribir("")
    escribir("API del módulo std/cliente_http:")
    escribir("  obtener(url)              → GET")
    escribir("  enviar(url, cuerpo)       → POST")
    escribir("  actualizar(url, cuerpo)   → PUT")
    escribir("  modificar_parcial(url, c) → PATCH")
    escribir("  eliminar(url)             → DELETE")
    escribir("")
    escribir("Todas devuelven Resultado<RespuestaCliente, ErrorHTTP>:")
    escribir("  Ok(respuesta) → codigo, status, cabeceras, cuerpo")
    escribir("  Error(e)      → e.mensaje, e.codigo")
}

main()

