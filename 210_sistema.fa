/// Módulo sistema: información del SO y del entorno
/// Conceptos: std/sistema, variables de entorno, Opcion, Resultado
/// Nivel: intermedio
importar "std/io"

importar "std/sistema"

funcion main() {
    escribir("=== MÓDULO SISTEMA ===\n")
    escribir("  Sistema operativo: " + sistema.sistema_operativo())
    escribir("  Versión de Forja:  " + sistema.version_forja())
    escribir("  Tiempo (ms):       " + sistema.tiempo_ms())
    // directorio_actual() devuelve un Resultado
    variable dir = sistema.directorio_actual()
    coincidir (dir) {
        caso Ok(ruta) -> {
            escribir("  Directorio actual: " + ruta)
        }
        caso Error(e) -> {
            escribir("  Directorio actual: error (" + e.mensaje + ")")
        }
    }
    // variable_entorno() devuelve una Opcion
    variable path = sistema.variable_entorno("PATH")
    coincidir (path) {
        caso Algo(valor) -> {
            escribir("  PATH definido (" + longitud(valor) + " caracteres)")
        }
        caso Ninguno -> {
            escribir("  PATH no definido")
        }
    }
    variable inexistente = sistema.variable_entorno("FORJA_VARIABLE_QUE_NO_EXISTE")
    coincidir (inexistente) {
        caso Algo(valor) -> {
            escribir("  (inesperado) " + valor)
        }
        caso Ninguno -> {
            escribir("  Variable de prueba: no definida (correcto)")
        }
    }
    escribir("")
    escribir("  Argumentos del programa: " + longitud(sistema.argumentos()) + "")
    escribir("")
    escribir("Opcion y Resultado obligan a manejar los dos casos:")
    escribir("  variable_entorno → Opcion (Algo / Ninguno)")
    escribir("  directorio_actual → Resultado (Ok / Error)")
}

main()

