/// Patrón Command
/// Conceptos: command, encapsulación, operaciones, deshacer, cola de comandos
/// Nivel: avanzado
importar "std/io"

// El patrón Command encapsula una solicitud como un objeto,
// permitiendo parametrizar clientes con diferentes solicitudes,
// encolar operaciones y soportar operaciones reversibles (deshacer).
clase Comando {
    nombre
    ejecutado

    constructor() {
        self.nombre = ""
        self.ejecutado = falso
    }
    funcion ejecutar(arg) {
        escribir("  (comando base - debe ser sobrescrito)")
    }
    funcion deshacer(arg) {
        escribir("  (deshacer base - debe ser sobrescrito)")
    }
}

clase ComandoSumar {
    nombre
    ejecutado
    valor_anterior

    constructor() {
        self.nombre = "Sumar"
        self.ejecutado = falso
        self.valor_anterior = 0
    }
    funcion ejecutar(valor) {
        self.valor_anterior = valor
        escribir("  ➕ Sumando " + valor + "")
        self.ejecutado = verdadero
        retornar valor
    }
    funcion deshacer() {
        si (self.ejecutado) {
            escribir("  ↩️ Deshaciendo suma de " + self.valor_anterior + "")
            self.ejecutado = falso
            retornar -self.valor_anterior
        }
        escribir("  ⚠️ Nada que deshacer")
        retornar 0
    }
}

clase ComandoMultiplicar {
    nombre
    ejecutado
    factor_anterior

    constructor() {
        self.nombre = "Multiplicar"
        self.ejecutado = falso
        self.factor_anterior = 0
    }
    funcion ejecutar(valor) {
        self.factor_anterior = valor
        escribir("  ✖️ Multiplicando por " + valor + "")
        self.ejecutado = verdadero
        retornar valor
    }
    funcion deshacer() {
        si (self.ejecutado) {
            escribir("  ↩️ Deshaciendo multiplicación por " + self.factor_anterior + "")
            self.ejecutado = falso
            retornar 1 / self.factor_anterior
        }
        escribir("  ⚠️ Nada que deshacer")
        retornar 1
    }
}

clase ComandoRestar {
    nombre
    ejecutado
    valor_anterior

    constructor() {
        self.nombre = "Restar"
        self.ejecutado = falso
        self.valor_anterior = 0
    }
    funcion ejecutar(valor) {
        self.valor_anterior = valor
        escribir("  ➖ Restando " + valor + "")
        self.ejecutado = verdadero
        retornar -valor
    }
    funcion deshacer() {
        si (self.ejecutado) {
            escribir("  ↩️ Deshaciendo resta de " + self.valor_anterior + "")
            self.ejecutado = falso
            retornar self.valor_anterior
        }
        escribir("  ⚠️ Nada que deshacer")
        retornar 0
    }
}

clase CalculadoraConComandos {
    valor_actual
    historial
    indice_historial

    constructor() {
        self.valor_actual = 0
        self.historial = []
        self.indice_historial = 0
    }
    funcion ejecutar_comando(cmd, argumento) {
        variable cambio = cmd.ejecutar(argumento)
        self.valor_actual = self.valor_actual + cambio
        self.historial[self.indice_historial] = cmd
        self.indice_historial = self.indice_historial + 1
        escribir("  = Resultado: " + self.valor_actual + "")
    }
    funcion deshacer() {
        si (self.indice_historial > 0) {
            self.indice_historial = self.indice_historial - 1
            variable cmd = self.historial[self.indice_historial]
            variable cambio = cmd.deshacer()
            self.valor_actual = self.valor_actual + cambio
            escribir("  = Resultado tras deshacer: " + self.valor_actual + "")
        } sino {
            escribir("  ⚠️ No hay más operaciones para deshacer")
        }
    }
    funcion mostrar_historial() {
        escribir("  Historial (" + self.indice_historial + " comandos):")
        variable i = 0
        mientras (i < self.indice_historial) {
            variable cmd = self.historial[i]
            escribir("    " + i + 1 + ". " + cmd.nombre + "")
            i = i + 1
        }
    }
}

funcion main() {
    escribir("=== PATRÓN COMMAND ===\n")
    escribir("Encapsula operaciones como objetos con deshacer.\n")
    variable calc = nuevo CalculadoraConComandos()
    escribir("Valor inicial: " + calc.valor_actual + "")
    escribir("")
    escribir("Ejecutando comandos:")
    calc.ejecutar_comando(nuevo ComandoSumar(), 10)
    calc.ejecutar_comando(nuevo ComandoMultiplicar(), 2)
    calc.ejecutar_comando(nuevo ComandoSumar(), 5)
    calc.ejecutar_comando(nuevo ComandoRestar(), 3)
    escribir("")
    escribir("Deshaciendo operaciones:")
    calc.deshacer()
    calc.deshacer()
    calc.deshacer()
    escribir("")
    calc.mostrar_historial()
    escribir("")
    escribir("El patrón Command es útil para:")
    escribir("  • Sistemas con operaciones deshacer/rehacer")
    escribir("  • Colas de tareas y operaciones batch")
    escribir("  • Menús y acciones de interfaz de usuario")
    escribir("  • Transacciones y logging de operaciones")
}

main()

