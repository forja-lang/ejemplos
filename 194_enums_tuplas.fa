importar "std/io"

tipo Color = RGB(Entero, Entero, Entero) | Hex(Texto)

funcion describir(c: Color) -> Texto {
    coincidir (c) {
        caso RGB(r, g, b) -> {
            retornar "RGB(" + r + "," + g + "," + b + ")"
        }
        caso Hex(v) -> {
            retornar "#" + v + ""
        }
    }
}

funcion intercambiar(a, b) {
    retornar [b, a]
}

funcion main() {
    escribir("=== Enums con datos y tuplas ===")
    escribir(describir(RGB(255, 128, 0)))
    escribir(describir(Hex("00ff00")))
    variable t = [10, "veinte", 30]
    escribir("longitud=" + longitud(t) + "")
    escribir("t[0]=" + t[0] + " t[1]=" + t[1] + " t[2]=" + t[2] + "")
    variable x, y = intercambiar(1, 2)
    escribir("x=" + x + " y=" + y + "")
    variable p, q = [7, 8]
    escribir("p=" + p + " q=" + q + "")
}

main()

