/// Implementar múltiples rasgos
/// Conceptos: múltiples implementa, varios rasgos por clase
/// Nivel: intermedio
importar "std/io"

rasgo Volador {
    funcion volar()
    funcion aterrizar() -> Texto
}

rasgo Navegante {
    funcion obtener_posicion() -> Texto
}

rasgo Mantenible {
    funcion necesita_mantenimiento() -> Booleano
}

clase Avion {
    modelo
    horas_vuelo

    constructor() {
        self.modelo = "Desconocido"
        self.horas_vuelo = 0
    }
}

implementa Volador para Avion {
    funcion volar() {
        escribir("" + self.modelo + ": Volando...")
    }
    funcion aterrizar() -> Texto {
        retornar "" + self.modelo + ": Aterrizando..."
    }
}

implementa Navegante para Avion {
    funcion obtener_posicion() -> Texto {
        retornar "Lat: -34.60, Lon: -58.38"
    }
}

