/// Buffer Circular (Ring Buffer)
/// Conceptos: buffer circular, ring buffer, estructura de datos, productor-consumidor
/// Nivel: avanzado
importar "std/io"

// Un buffer circular (ring buffer) es una estructura de datos FIFO
// de tamaño fijo que reutiliza memoria. Cuando el buffer se llena,
// los datos nuevos sobrescriben los más antiguos.
clase BufferCircular {
    buffer
    capacidad
    cabeza
    cola
    lleno

    constructor() {
        self.buffer = []
        self.capacidad = 0
        self.cabeza = 0
        self.cola = 0
        self.lleno = falso
    }
    funcion init(capacidad) {
        self.capacidad = capacidad
        self.buffer = []
        self.cabeza = 0
        self.cola = 0
        self.lleno = falso
        variable i = 0
        mientras (i < capacidad) {
            self.buffer[i] = 0
            i = i + 1
        }
    }
    funcion esta_vacia() -> Booleano {
        retornar !self.lleno && self.cabeza == self.cola
    }
    funcion esta_llena() -> Booleano {
        retornar self.lleno
    }
    funcion tamano_actual() -> Entero {
        si (self.lleno) {
            retornar self.capacidad
        }
        si (self.cabeza >= self.cola) {
            retornar self.cabeza - self.cola
        }
        retornar self.capacidad - self.cola + self.cabeza
    }
    funcion espacio_libre() -> Entero {
        retornar self.capacidad - self.tamano_actual()
    }
    funcion encolar(valor) {
        self.buffer[self.cabeza] = valor
        si (self.lleno) {
            self.cola = (self.cola + 1) % self.capacidad
        }
        self.cabeza = (self.cabeza + 1) % self.capacidad
        self.lleno = (self.cabeza == self.cola)
        escribir("  📥 Encolado: " + valor + "  [buff: " + self.tamano_actual() + "/" + self.capacidad + "]")
    }
    funcion desencolar() -> Entero {
        si (self.esta_vacia()) {
            escribir("  ⚠️ Buffer vacío: no hay datos para desencolar")
            retornar nulo
        }
        variable valor = self.buffer[self.cola]
        self.lleno = falso
        self.cola = (self.cola + 1) % self.capacidad
        escribir("  📤 Desencolado: " + valor + "  [buff: " + self.tamano_actual() + "/" + self.capacidad + "]")
        retornar valor
    }
    funcion ver_frente() -> Entero {
        si (self.esta_vacia()) {
            escribir("  ⚠️ Buffer vacío")
            retornar nulo
        }
        retornar self.buffer[self.cola]
    }
    funcion mostrar() {
        escribir("  Buffer circular [" + self.tamano_actual() + "/" + self.capacidad + "]:")
        si (self.esta_vacia()) {
            escribir("    (vacío)")
            retornar
        }
        variable i = self.cola
        variable elementos_mostrados = 0
        mientras (elementos_mostrados < self.tamano_actual()) {
            escribir("    [" + i + "]: " + self.buffer[i] + "")
            i = (i + 1) % self.capacidad
            elementos_mostrados = elementos_mostrados + 1
        }
    }
}

funcion main() {
    escribir("=== BUFFER CIRCULAR (RING BUFFER) ===\n")
    escribir("Estructura FIFO de tamaño fijo que reutiliza memoria.\n")
    variable buffer = nuevo BufferCircular()
    buffer.init(5)
    escribir("Buffer creado: capacidad = 5")
    escribir("")
    escribir("--- Encolando 3 elementos ---")
    buffer.encolar(10)
    buffer.encolar(20)
    buffer.encolar(30)
    buffer.mostrar()
    escribir("")
    escribir("--- Desencolando 2 elementos ---")
    buffer.desencolar()
    buffer.desencolar()
    buffer.mostrar()
    escribir("")
    escribir("--- Encolando 4 más (total 5, llenando) ---")
    buffer.encolar(40)
    buffer.encolar(50)
    buffer.encolar(60)
    buffer.encolar(70)
    buffer.mostrar()
    escribir("")
    escribir("--- Buffer lleno! Sobrescribiendo (encolar más) ---")
    buffer.encolar(80)
    buffer.encolar(90)
    buffer.mostrar()
    escribir("")
    escribir("--- Vaciando todo ---")
    mientras (!buffer.esta_vacia()) {
        buffer.desencolar()
    }
    buffer.mostrar()
    escribir("")
    escribir("Ventajas del buffer circular:")
    escribir("  • Tamaño fijo sin realocaciones de memoria")
    escribir("  • Operaciones de encolar/desencolar en O(1)")
    escribir("  • Ideal para streaming y buffers de audio/video")
    escribir("  • Perfecto para el patrón productor-consumidor")
}

main()

