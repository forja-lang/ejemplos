importar "std/io"

funcion mitad(n) -> Opcion<Entero> {
    variable m = n / 2
    si (m * 2 == n) {
        retornar Algo(m)
    }
    retornar Ninguno()
}

funcion reducir(n) -> Opcion<Entero> {
    variable a = mitad(n)?
    variable b = mitad(a)?
    retornar Algo(b)
}

funcion main() {
    escribir("=== Propagación de Opcion con ? ===")
    variable r1 = reducir(8)
    coincidir (r1) {
        caso Alguno(v) -> {
            escribir("reducir(8) = Alguno(" + v + ")")
        }
        caso Ninguno -> {
            escribir("reducir(8) = Ninguno")
        }
    }
    variable r2 = reducir(6)
    coincidir (r2) {
        caso Alguno(v) -> {
            escribir("reducir(6) = Alguno(" + v + ")")
        }
        caso Ninguno -> {
            escribir("reducir(6) = Ninguno")
        }
    }
}

main()

