/// Patrón Iterator vía rasgo
/// Conceptos: iterador, rasgo Iterador, recorrer colecciones, abstracción
/// Nivel: avanzado
importar "std/io"

// Implementación del patrón Iterator usando rasgos
rasgo Iterador {
    funcion siguiente() -> Opcion<T>
}

clase IteradorLista {
    elementos
    posicion

    constructor(lista) {
        self.elementos = lista
        self.posicion = 0
    }
}

implementa Iterador para IteradorLista {
    funcion siguiente() -> Opcion<Entero> {
        si (self.posicion < longitud(self.elementos)) {
            variable valor = self.elementos[self.posicion]
            self.posicion = self.posicion + 1
            retornar Algo(valor)
        }
        retornar Ninguno
    }
}

