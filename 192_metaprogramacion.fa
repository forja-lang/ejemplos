/// Metaprogramación: generar código Forja desde Forja
/// Conceptos: metaprogramación, construcción de texto, generación de código
/// Nivel: avanzado
importar "std/io"

// Genera el código de un getter para un campo.
funcion generar_getter(campo: Texto) -> Texto {
    variable codigo = "    funcion obtener_" + campo + "() {\n"
    codigo = codigo + "        retornar self." + campo + "\n"
    codigo = codigo + "    }\n"
    retornar codigo
}

// Genera el código de un setter para un campo.
funcion generar_setter(campo: Texto) -> Texto {
    variable codigo = "    funcion fijar_" + campo + "(valor) {\n"
    codigo = codigo + "        self." + campo + " = valor\n"
    codigo = codigo + "    }\n"
    retornar codigo
}

// Genera una clase completa a partir de una lista de campos.
funcion generar_clase(nombre: Texto, campos: Arreglo) -> Texto {
    variable codigo = "clase " + nombre + " {\n"
    variable i = 0
    mientras (i < longitud(campos)) {
        codigo = codigo + "    " + campos[i] + "\n"
        i = i + 1
    }
    codigo = codigo + "\n    constructor() {\n"
    variable j = 0
    mientras (j < longitud(campos)) {
        codigo = codigo + "        self." + campos[j] + " = nulo\n"
        j = j + 1
    }
    codigo = codigo + "    }\n\n"
    variable k = 0
    mientras (k < longitud(campos)) {
        codigo = codigo + generar_getter(campos[k])
        codigo = codigo + generar_setter(campos[k])
        k = k + 1
    }
    codigo = codigo + "}"
    retornar codigo
}

funcion main() {
    escribir("=== METAPROGRAMACIÓN ===\n")
    escribir("Forja genera código Forja a partir de datos.\n")
    variable campos = ["nombre", "edad", "ciudad"]
    variable codigo = generar_clase("Persona", campos)
    escribir("Código generado:")
    escribir(codigo)
    escribir("")
    escribir("Líneas generadas: " + (lineas(codigo)) + "")
    escribir("Caracteres: " + longitud(codigo) + "")
    escribir("")
    escribir("Ventajas:")
    escribir("  • Menos código repetitivo a mano")
    escribir("  • El patrón se define una sola vez")
    escribir("  • Fácil de auditar: el texto generado se puede imprimir")
}

// Cuenta las líneas de un texto (sin depender de la stdlib).
funcion lineas(texto: Texto) -> Entero {
    variable n = 1
    variable i = 0
    mientras (i < longitud(texto)) {
        si (texto[i] == "\n") {
            n = n + 1
        }
        i = i + 1
    }
    retornar n
}

main()

