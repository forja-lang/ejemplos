/// Cliente HTTP/2
/// Conceptos: std/cliente_h2, multiplexación, prioridades, frames
/// Nivel: experto
importar "std/io"
importar "std/cliente_h2"

funcion main() {
    escribir("=== CLIENTE HTTP/2 ===\n")
    escribir("Una sola conexión TCP, varias peticiones en paralelo (streams).")
    escribir("")

    variable url = "http://localhost:8081/estado"
    escribir("  cliente_h2.obtener(" + url + ") ...")

    variable respuesta = cliente_h2.obtener(url)
    coincidir (respuesta) {
        caso Ok(r) -> {
            escribir("  código: " + r.codigo)
            escribir("  estado: " + r.status)
            escribir("  cuerpo: " + longitud(r.cuerpo) + " caracteres")
        }
        caso Error(e) -> {
            escribir("  ⚠️ no se pudo conectar: " + e.mensaje)
            escribir("  (normal si no hay servidor h2c escuchando)")
        }
    }

    escribir("")
    escribir("Ventajas frente a HTTP/1.1:")
    escribir("  • multiplexación: muchos streams por conexión")
    escribir("  • sin head-of-line blocking entre peticiones")
    escribir("  • cabeceras comprimidas (HPACK)")
    escribir("")
    escribir("API de std/cliente_h2:")
    escribir("  obtener(url)              → GET")
    escribir("  enviar(url, cuerpo)       → POST")
    escribir("  actualizar(url, cuerpo)   → PUT")
    escribir("  modificar_parcial(url, c) → PATCH")
    escribir("  eliminar(url)             → DELETE")
}

main()
