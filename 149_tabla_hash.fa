/// Tabla hash (implementación manual)
/// Conceptos: tabla hash, función hash, colisiones, encadenamiento, buckets
/// Nivel: avanzado
importar "std/io"

clase ParHash {
    clave
    valor
    siguiente

    constructor(c, v) {
        self.clave = c
        self.valor = v
        self.siguiente = nulo
    }
}

clase TablaHash {
    buckets
    capacidad
    tamano

    constructor(cap) {
        self.capacidad = cap
        self.tamano = 0
        self.buckets = []
        variable i = 0
        mientras (i < cap) {
            self.buckets[i] = nulo
            i = i + 1
        }
    }
    funcion hash(clave) -> Entero {
        variable h = 0
        variable i = 0
        mientras (i < longitud(clave)) {
            h = h * 31 + clave[i]
            i = i + 1
        }
        si (h < 0) {
            h = -h
        }
        retornar h % self.capacidad
    }
    funcion insertar(clave, valor) {
        variable indice = self.hash(clave)
        variable actual = self.buckets[indice]
        // Buscar si ya existe la clave
        mientras (actual != nulo) {
            si (actual.clave == clave) {
                actual.valor = valor
                // actualizar
                retornar
            }
            actual = actual.siguiente
        }
        // Si no existe, agregar al inicio
        variable nuevo = nuevo ParHash(clave, valor)
        nuevo.siguiente = self.buckets[indice]
        tamano = self.tamano + 1
    }
    funcion obtener(clave) {
        variable indice = self.hash(clave)
        variable actual = self.buckets[indice]
        mientras (actual != nulo) {
            si (actual.clave == clave) {
                retornar actual.valor
            }
            actual = actual.siguiente
        }
        retornar nulo
    }
    funcion eliminar(clave) -> Booleano {
        variable indice = self.hash(clave)
        variable actual = self.buckets[indice]
        variable previo = nulo
        mientras (actual != nulo) {
            si (actual.clave == clave) {
                si (previo == nulo) {
                    self.buckets[indice] = actual.siguiente
                } sino {
                    previo.siguiente = actual.siguiente
                }
                self.tamano = self.tamano - 1
                retornar verdadero
            }
            previo = actual
            actual = actual.siguiente
        }
        retornar falso
    }
    funcion mostrar() {
        escribir("Tabla Hash (" + self.tamano + " elementos):")
        variable i = 0
        mientras (i < self.capacidad) {
            variable linea = "  [" + i + "]: "
            variable actual = self.buckets[i]
            mientras (actual != nulo) {
                actual.siguiente
            }
            linea = linea + "∅"
            escribir("" + linea + "")
            i = i + 1
        }
    }
}

funcion main() {
    escribir("=== Tabla Hash ===\n")
    variable ht = nuevo TablaHash(8)
    ht.insertar("nombre", "Ana")
    ht.insertar("edad", "28")
    ht.insertar("ciudad", "Buenos Aires")
    ht.insertar("profesion", "Ingeniera")
    // Forzar colisión con clave de mismo hash
    ht.insertar("nombre", "Carlos")
    // actualiza
    ht.insertar("pais", "Argentina")
    ht.mostrar()
    escribir("")
    escribir("Búsquedas:")
    escribir("  nombre → " + ht.obtener("nombre") + "")
    escribir("  edad → " + ht.obtener("edad") + "")
    escribir("  inexistente → " + ht.obtener("xyz") + "")
    ht.eliminar("edad")
    escribir("")
    escribir("Después de eliminar 'edad':")
    escribir("  edad → " + ht.obtener("edad") + "")
    ht.mostrar()
    escribir("")
    escribir("Tabla hash: inserciones y búsquedas O(1) promedio.")
}

main()

