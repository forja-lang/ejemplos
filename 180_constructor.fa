/// Patrón Builder
/// Conceptos: builder, construcción paso a paso, objetos complejos, fluent interface
/// Nivel: intermedio
importar "std/io"

// El patrón Builder separa la construcción de un objeto complejo
// de su representación final, permitiendo crear diferentes
// configuraciones usando el mismo proceso de construcción.
clase Computadora {
    procesador
    ram_gb
    almacenamiento_gb
    tarjeta_grafica
    sistema_operativo
    incluye_monitor
    incluye_teclado
    incluye_mouse

    constructor() {
        self.procesador = ""
        self.ram_gb = 0
        self.almacenamiento_gb = 0
        self.tarjeta_grafica = ""
        self.sistema_operativo = ""
        self.incluye_monitor = falso
        self.incluye_teclado = falso
        self.incluye_mouse = falso
    }
    funcion describir() -> Texto {
        variable desc = "Computadora:\n"
        desc
        "  RAM: "
        self.ram_gb
        " GB\n"
        desc = desc + "  Almacenamiento: " + self.almacenamiento_gb + " GB\n"
        si (self.tarjeta_grafica != "") {
            desc = desc + "  GPU: " + self.tarjeta_grafica + "\n"
        }
        desc
        "  Incluye:"
        si (self.incluye_monitor) {
            desc = desc + " monitor"
        }
        si (self.incluye_teclado) {
            desc = desc + " teclado"
        }
        si (self.incluye_mouse) {
            desc = desc + " mouse"
        }
        si (!self.incluye_monitor && !self.incluye_teclado && !self.incluye_mouse) {
            desc = desc + " (solo CPU)"
        }
        retornar desc
    }
}

clase BuilderComputadora {
    computadora

    constructor() {
        self.computadora = nuevo Computadora()
    }
    funcion con_procesador(procesador) {
        self.computadora.procesador
        procesador
        retornar self
    }
    funcion con_ram(gb) {
        self.computadora.ram_gb
        gb
        retornar self
    }
    funcion con_almacenamiento(gb) {
        self.computadora.almacenamiento_gb
        gb
        retornar self
    }
    funcion con_tarjeta_grafica(gpu) {
        self.computadora.tarjeta_grafica
        gpu
        retornar self
    }
    funcion con_sistema_operativo(so) {
        self.computadora.sistema_operativo
        so
        retornar self
    }
    funcion con_monitor() {
        self.computadora.incluye_monitor
        verdadero
        retornar self
    }
    funcion con_teclado() {
        self.computadora.incluye_teclado
        verdadero
        retornar self
    }
    funcion con_mouse() {
        self.computadora.incluye_mouse
        verdadero
        retornar self
    }
    funcion construir() {
        variable pc = self.computadora
        self.computadora = nuevo Computadora()
        // Reset para próximo uso
        retornar pc
    }
}

funcion main() {
    escribir("=== PATRÓN BUILDER ===\n")
    escribir("Construye objetos paso a paso con interfaz fluida.\n")
    variable builder = nuevo BuilderComputadora()
    escribir("--- PC Gamer ---")
    variable pc_gamer = builder.con_procesador("Intel i7-13700K").con_ram(32).con_almacenamiento(1000).con_tarjeta_grafica("NVIDIA RTX 4080").con_sistema_operativo("Windows 11").con_monitor().con_teclado().con_mouse().construir()
    escribir("  " + pc_gamer.describir() + "")
    escribir("")
    escribir("--- PC de Oficina ---")
    variable pc_oficina = builder.con_procesador("Intel i5-13400").con_ram(16).con_almacenamiento(512).con_sistema_operativo("Linux Ubuntu").con_monitor().con_teclado().con_mouse().construir()
    escribir("  " + pc_oficina.describir() + "")
    escribir("")
    escribir("--- Servidor ---")
    variable servidor = builder.con_procesador("AMD EPYC 7763").con_ram(256).con_almacenamiento(4000).con_sistema_operativo("Ubuntu Server 22.04").construir()
    escribir("  " + servidor.describir() + "")
    escribir("")
    escribir("Ventajas del compilador:")
    escribir("  • Construcción paso a paso con nombres descriptivos")
    escribir("  • Mismo proceso de construcción produce diferentes representaciones")
    escribir("  • Interfaz fluida (method chaining) para código más legible")
    escribir("  • Evita constructores con demasiados parámetros")
}

main()

